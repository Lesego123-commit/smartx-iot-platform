<!--
  PROG7312 - Programming 3B | Part 1: Smart-X Data Ingestion & Validation Gateway
  File:    SmartX.Client/App.xaml
  Purpose: Application definition; merges the shared theme resource dictionary.
  
  References (Harvard) - sources consulted for the techniques used in this file:
    - Microsoft, 2024. Windows Presentation Foundation (WPF) documentation. Microsoft Learn. Available at: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/ [Accessed 10 September 2026].
    - Microsoft, 2024. Define and reference XAML resources (WPF). Microsoft Learn. Available at: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/systems/xaml-resources-define [Accessed 10 September 2026].
-->
<Application x:Class="SmartX.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartX.Client"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
