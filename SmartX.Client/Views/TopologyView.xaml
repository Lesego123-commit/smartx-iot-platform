<!--
  PROG7312 - Programming 3B | Part 3 (PoE): Smart-X Network Topology & Mesh Routing
  File:    SmartX.Client/Views/TopologyView.xaml
  Purpose: Network Topology page - visualises the mesh graph, traces MST-based routes to the
           gateway, runs BFS/DFS traversal, and queries a device's AVL history by time range.

  References (Harvard) - sources consulted for the techniques used in this file:
    - Microsoft, 2024. Styles and templates (WPF). Microsoft Learn. Available at: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/styles-templates-overview [Accessed 25 September 2026].
    - Microsoft, 2024. Shapes and basic drawing in WPF overview. Microsoft Learn. Available at: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/graphics-multimedia/shapes-and-basic-drawing-in-wpf-overview [Accessed 25 September 2026].
    - Microsoft, 2024. Canvas Class. Microsoft Learn. Available at: https://learn.microsoft.com/en-us/dotnet/api/system.windows.controls.canvas [Accessed 25 September 2026].
-->
<UserControl x:Class="SmartX.Client.Views.TopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Network Topology &amp; Mesh Routing" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Visualise the mesh, trace power-efficient routes, and query historical telemetry."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#2634D399" CornerRadius="14" Padding="12,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnDot" Width="9" Height="9" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnText" Text="Connecting…" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Content="Refresh" Style="{StaticResource Ghost}" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="300"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <!-- Routing -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Routing (MST path)" Style="{StaticResource H2}"/>
                            <TextBlock Text="Sensor node" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,4"/>
                            <ComboBox x:Name="RouteDevice"/>
                            <Button Content="Trace route to gateway" Style="{StaticResource Accent}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Click="TraceRoute_Click"/>
                            <TextBlock x:Name="RouteResult" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Traversal + MST -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Graph analysis" Style="{StaticResource H2}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="BFS" Style="{StaticResource Ghost}" Click="Bfs_Click"/>
                                <Button Content="DFS" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="Dfs_Click"/>
                                <Button x:Name="MstButton" Content="Show MST" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="Mst_Click"/>
                                <Button Content="Clear" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="Clear_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="AnalysisResult" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Historical log (AVL range query) -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Historical log (AVL range query)" Style="{StaticResource H2}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Device" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="HistoryDevice"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Window" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="HistoryWindow" SelectedIndex="1">
                                        <ComboBoxItem Content="10 min"/>
                                        <ComboBoxItem Content="20 min"/>
                                        <ComboBoxItem Content="30 min"/>
                                        <ComboBoxItem Content="60 min"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Button Content="Query range" Style="{StaticResource Accent}" Margin="0,12,0,8"
                                    HorizontalAlignment="Left" Click="History_Click"/>
                            <TextBlock x:Name="HistoryResult" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Margin="0,8,0,0" Padding="10" Height="150">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="HistoryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="12"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: graph canvas -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,0,0">
                        <TextBlock Text="Mesh network" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="GraphSubtitle" Text="" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
                    </StackPanel>
                    <Canvas x:Name="GraphCanvas" Grid.Row="1" ClipToBounds="True" Background="Transparent"
                            SizeChanged="GraphCanvas_SizeChanged"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,6,0,4">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="gateway / MST link" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,16,0"/>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="online node" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,16,0"/>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource BadBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="down / unreachable" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,16,0"/>
                        <Rectangle Width="16" Height="4" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="traced route" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
