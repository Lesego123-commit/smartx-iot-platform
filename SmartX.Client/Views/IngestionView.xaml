<!--
  PROG7312 - Programming 3B | Part 1: Smart-X Data Ingestion & Validation Gateway
  File:    SmartX.Client/Views/IngestionView.xaml
  Purpose: Ingestion view: registration form, file upload and live dashboard.
  
  References (Harvard) - sources consulted for the techniques used in this file:
    - Microsoft, 2024. Styles and templates (WPF). Microsoft Learn. Available at: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/styles-templates-overview [Accessed 10 September 2026].
    - Microsoft, 2024. Data templating overview (WPF). Microsoft Learn. Available at: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/data/data-templating-overview [Accessed 10 September 2026].
    - Microsoft, 2024. ItemsControl Class. Microsoft Learn. Available at: https://learn.microsoft.com/en-us/dotnet/api/system.windows.controls.itemscontrol [Accessed 10 September 2026].
    - Microsoft, 2024. Control templates (WPF). Microsoft Learn. Available at: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/control-templates [Accessed 10 September 2026].
-->
<UserControl x:Class="SmartX.Client.Views.IngestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Sensor Data Ingestion &amp; Telemetry" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Text="Register devices, attach configs, and monitor the mesh in real time." Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="ConnPill" Background="#2634D399" CornerRadius="14" Padding="12,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnDot" Width="9" Height="9" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnText" Text="Connecting…" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <CheckBox x:Name="LiveToggle" Content="Live" Foreground="{StaticResource TextBrush}" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Refresh" Style="{StaticResource Ghost}" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: forms -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                <StackPanel>
                    <!-- Register -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Register device" Style="{StaticResource H2}"/>
                            <TextBlock Text="MAC address / unique identifier" Style="{StaticResource Muted}" Margin="0,12,0,4"/>
                            <TextBox x:Name="MacBox" Text="3C:71:BF:0A:2D:F1"/>
                            <TextBlock Text="Deployment location (Facility / Zone / Node)" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
                            <TextBox x:Name="LocationBox" Text="Facility A / Zone 1 / Sub-Zone B"/>
                            <TextBlock Text="Category" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
                            <ComboBox x:Name="CategoryCombo" SelectedIndex="0">
                                <ComboBoxItem Content="Environmental"/>
                                <ComboBoxItem Content="PowerConsumption"/>
                                <ComboBoxItem Content="Actuator"/>
                            </ComboBox>
                            <TextBlock Text="Description (optional)" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
                            <TextBox x:Name="DescBox" Text="Rooftop soil-moisture probe"/>
                            <Button Content="Register device" Style="{StaticResource Accent}" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Click="Register_Click"/>
                            <TextBlock x:Name="RegStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Attach media/log -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Attach config / log / photo" Style="{StaticResource H2}"/>
                            <TextBlock Text="Target device" Style="{StaticResource Muted}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="UploadDeviceCombo"/>
                            <Button Content="Choose file…" Style="{StaticResource Ghost}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Click="ChooseFile_Click"/>
                            <TextBlock x:Name="SelectedFileText" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Text="No file selected." TextWrapping="Wrap"/>
                            <Button Content="Upload to gateway" Style="{StaticResource Accent}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Click="Upload_Click"/>
                            <TextBlock x:Name="UploadStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Push telemetry -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Push telemetry sample" Style="{StaticResource H2}"/>
                            <TextBlock Text="Device" Style="{StaticResource Muted}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="IngestDeviceCombo"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Metric" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MetricBox" Text="soil_moisture"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Kind" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="KindCombo" SelectedIndex="0">
                                        <ComboBoxItem Content="Float"/>
                                        <ComboBoxItem Content="Int"/>
                                        <ComboBoxItem Content="Bool"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Value (number, or true/false for Bool)" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
                            <TextBox x:Name="ValueBox" Text="500"/>
                            <Button Content="Ingest sample" Style="{StaticResource Accent}" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Click="Ingest_Click"/>
                            <TextBlock x:Name="IngestStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: live engagement dashboard -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- KPI strip -->
                <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,14">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiDevices" Text="—" Style="{StaticResource H1}" FontSize="24"/>
                            <TextBlock Text="DEVICES" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiSamples" Text="—" Style="{StaticResource H1}" FontSize="24"/>
                            <TextBlock Text="SAMPLES" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiAnomalies" Text="—" Style="{StaticResource H1}" FontSize="24" Foreground="{StaticResource WarnBrush}"/>
                            <TextBlock Text="ANOMALIES" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiSilent" Text="—" Style="{StaticResource H1}" FontSize="24" Foreground="{StaticResource BadBrush}"/>
                            <TextBlock Text="SILENT" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiRate" Text="—" Style="{StaticResource H1}" FontSize="24" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="INGEST / MIN" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Heat-strip header -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,10">
                    <TextBlock Text="Anomaly Heat-Strip" Style="{StaticResource H2}"/>
                    <TextBlock Text="live device health — spikes &amp; disconnects surface instantly" Style="{StaticResource Muted}"
                               VerticalAlignment="Bottom" Margin="10,0,0,2"/>
                </StackPanel>

                <!-- Device tiles -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DeviceStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="188" Margin="0,0,10,10" Padding="0">
                                    <StackPanel>
                                        <Border Height="5" Background="{Binding AccentBar}" CornerRadius="10,10,0,0"/>
                                        <StackPanel Margin="14,12,14,14">
                                            <TextBlock Text="{Binding ShortId}" FontFamily="Consolas" FontSize="14"/>
                                            <TextBlock Text="{Binding Location}" Style="{StaticResource Muted}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding LastValue}" Style="{StaticResource H1}" FontSize="22" Margin="0,8,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                           FontSize="10.5" FontFamily="Segoe UI Semibold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AnomalyText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Alert wall -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Height="150">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Live Alert Wall" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AlertWall">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Muted}" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SeverityText}" Foreground="{Binding SeverityBrush}"
                                                       FontFamily="Segoe UI Semibold" FontSize="11"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
